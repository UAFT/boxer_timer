<?xml version="1.0" encoding="utf-8"?>
<!-- App-wide Android settings: android/ is regenerated by `npx cap add android` in CI, so they live in this plugin and are
     merged into the app manifest. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- «Сохранить в файл» (Documents/Fight Tech, @capacitor/filesystem): Android 6–10 ask for these; from Android 11 the
         app writes its own files there without any permission. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <!-- requestLegacyExternalStorage: Android 10 only (ignored from 11), so the Documents write works there too.
         Auto Backup stays on (owner, 2026-10-31); it carries the diaries and the app's localStorage, nothing else. -->
    <application
        android:requestLegacyExternalStorage="true"
        android:fullBackupContent="@xml/ft_backup_rules"
        android:dataExtractionRules="@xml/ft_data_extraction_rules">
        <!-- No WebView usage statistics to Google. -->
        <meta-data android:name="android.webkit.WebView.MetricsOptOut" android:value="true" />
    </application>
</manifest>
