<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the same set as ft_backup_rules.xml for the Google Drive backup and for a device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
        <include domain="root" path="app_webview/Default/Local Storage/" />
        <include domain="root" path="app_webview/Local Storage/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <include domain="root" path="app_webview/Default/Local Storage/" />
        <include domain="root" path="app_webview/Local Storage/" />
    </device-transfer>
</data-extraction-rules>
